---
import '../styles/global.css';
import SEO from '@components/SEO.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  type?: 'website' | 'article';
}

const { title, description, canonical, type } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <SEO title={title} description={description} canonical={canonical} type={type}>
      <slot name="head" />
    </SEO>
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-4 focus:rounded-lg focus:bg-pine-500 focus:px-4 focus:py-2 focus:text-cream-50"
    >
      Перейти к содержимому
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
