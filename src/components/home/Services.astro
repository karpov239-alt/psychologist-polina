---
import { SocialLink, PRICE } from '@utils/site';

const formats = [
  {
    title: 'Очная консультация в Ярославле',
    text: 'Встреча в уютном кабинете в Ярославле. Подойдёт, если вам важен живой контакт и отдельное пространство для разговора.',
    tags: ['Ярославль', 'Кабинет'],
  },
  {
    title: 'Онлайн-консультация',
    text: 'Встреча по видеосвязи в Zoom или Яндекс Телемост — из любой точки мира. По эффективности онлайн-формат не уступает очному.',
    tags: ['Zoom', 'Яндекс Телемост', 'Из любого города'],
  },
] as const;
---

<section id="services" class="bg-cream-50">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-24">
    <h2 class="font-display text-3xl font-semibold text-pine-800 sm:text-4xl">Форматы и стоимость</h2>
    <p class="mt-4 max-w-2xl leading-relaxed text-pine-700">
      Консультация длится 50 минут. Выберите формат, который удобнее вам, —
      очную встречу в Ярославле или онлайн.
    </p>

    <ul class="mt-10 grid gap-6 md:grid-cols-2">
      {formats.map((format) => (
        <li class="flex flex-col rounded-3xl border border-pine-100 bg-cream-100 p-8 transition-shadow hover:shadow-md">
          <h3 class="font-display text-2xl font-semibold text-pine-800">{format.title}</h3>
          <p class="mt-3 flex-1 leading-relaxed text-pine-700">{format.text}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {format.tags.map((tag) => (
              <li class="rounded-full bg-pine-100 px-3 py-1 text-xs font-medium text-pine-700">{tag}</li>
            ))}
          </ul>
          <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
            <p class="font-display text-2xl font-semibold text-pine-600">{PRICE}</p>
            <a
              href={SocialLink.Telegram}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full bg-pine-500 px-6 py-2.5 text-sm font-medium text-cream-50 transition-colors hover:bg-pine-600"
            >
              Записаться
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
