---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import { formatDate } from '@utils/date';

const articles = (
  await getCollection('articles', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  )
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<Layout
  title="Статьи о психологии"
  description="Статьи психолога Полины Дворецкой: тревога, отношения, самоценность, детско-родительские отношения. Тёплые и практичные материалы от психолога из Ярославля."
>
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <h1 class="font-display text-4xl font-semibold text-pine-800 sm:text-5xl">Статьи</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-pine-700">
      Здесь я делюсь мыслями о том, с чем люди чаще всего приходят на консультации:
      тревога, отношения, кризисы, поиск себя. Простыми словами и с практическими шагами.
    </p>

    {articles.length === 0 ? (
      <p class="mt-12 text-pine-700">Статьи скоро появятся.</p>
    ) : (
      <ul class="mt-12 grid gap-6">
        {articles.map((article) => (
          <li>
            <a
              href={`/articles/${article.id}/`}
              class="block rounded-2xl border border-pine-100 bg-cream-50 p-6 transition-shadow hover:shadow-md sm:p-8"
            >
              <h2 class="font-display text-2xl font-semibold text-pine-800">
                {article.data.title}
              </h2>
              <p class="mt-2 leading-relaxed text-pine-700">{article.data.description}</p>
              <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-pine-500">
                <time datetime={article.data.publishedAt.toISOString()}>
                  {formatDate(article.data.publishedAt)}
                </time>
                {article.data.tags.map((tag) => (
                  <span class="rounded-full bg-pine-100 px-3 py-1 text-xs text-pine-700">{tag}</span>
                ))}
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Layout>
