---
import { NAV_ITEMS, PRIVACY_POLICY_PATH, SocialLink, isPageLink } from '@utils/site';
import Link from '@components/Link.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-pine-100 bg-pine-900 text-cream-100">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-3">
    <div>
      <p class="font-display text-2xl font-semibold text-cream-50">Полина Дворецкая</p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-cream-200">
        Практикующий психолог, магистр психологии. Очные консультации в Ярославле и онлайн из любой точки мира.
      </p>
    </div>

    <nav aria-label="Навигация в подвале">
      <p class="text-sm font-semibold uppercase tracking-wide text-cream-300">Разделы</p>
      <ul class="mt-3 space-y-2 text-sm">
        {NAV_ITEMS.map((item) => (
          <li>
            <Link
              href={item.href}
              class:list={[
                'text-cream-100 transition-colors hover:text-cream-50 hover:underline',
                { 'font-medium': isPageLink(item.href) },
              ]}
            >
              {item.label}
            </Link>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-cream-300">Связаться</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li>
          <Link href={SocialLink.Vk} class="inline-flex items-center gap-1 transition-colors hover:text-cream-50 hover:underline">
            Профиль в VK
          </Link>
        </li>
        <li>
          <Link href={SocialLink.Max} class="inline-flex items-center gap-1 transition-colors hover:text-cream-50 hover:underline">
            Профиль в Max
          </Link>
        </li>
        <li>
          <Link href={SocialLink.B17} class="inline-flex items-center gap-1 transition-colors hover:text-cream-50 hover:underline">
            Профиль на b17.ru
          </Link>
        </li>
        <li>
          <Link href={`mailto:${SocialLink.Email}`} hideArrow class="transition-colors hover:text-cream-50 hover:underline">
            Почта: {SocialLink.Email}
          </Link>
        </li>
        <li>
          <Link href={SocialLink.Telegram} class="inline-flex items-center gap-1 transition-colors hover:text-cream-50 hover:underline">
            Профиль в Telegram
          </Link>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-pine-700">
    <div class="mx-auto max-w-6xl space-y-2 px-4 py-6 text-xs leading-relaxed text-cream-300 sm:px-6">
      <p>Сайт не является медицинским сервисом. Консультации не заменяют медицинскую помощь.</p>
      <p>
        <Link href={PRIVACY_POLICY_PATH} hideArrow class="underline underline-offset-2 transition-colors hover:text-cream-100">
          Политика конфиденциальности
        </Link>
      </p>
      <p>© {year} Полина Дворецкая. Все права защищены.</p>
    </div>
  </div>
</footer>
