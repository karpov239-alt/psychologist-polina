---
import { FAQ_ITEMS } from '@utils/faq';
---

<section id="faq" class="bg-cream-50">
  <div class="mx-auto max-w-3xl px-4 py-6 sm:px-6 lg:py-8">
    <h2 class="font-display text-3xl font-semibold text-pine-800 sm:text-4xl">Частые вопросы</h2>

    <div class="mt-8 space-y-4">
      {FAQ_ITEMS.map((item) => (
        <details class="group rounded-2xl border border-pine-100 bg-cream-100 px-6 py-4 open:shadow-sm">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-pine-800 [&::-webkit-details-marker]:hidden">
            {item.question}
            <svg
              class="size-5 shrink-0 text-pine-500 transition-transform group-open:rotate-180"
              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </summary>
          <div class="mt-3 space-y-3 leading-relaxed text-pine-700">
            {item.answer.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
