---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import { formatDate } from '@utils/date';
import { PSYCHOLOGIST_FULL_NAME, SITE_URL, SocialLink } from '@utils/site';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { Content } = await render(article);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  inLanguage: 'ru-RU',
  datePublished: article.data.publishedAt.toISOString(),
  ...(article.data.updatedAt && { dateModified: article.data.updatedAt.toISOString() }),
  keywords: article.data.keywords.join(', '),
  author: {
    '@type': 'Person',
    name: PSYCHOLOGIST_FULL_NAME,
    url: SITE_URL,
  },
  mainEntityOfPage: `${SITE_URL}/articles/${article.id}/`,
};
---

<Layout
  title={article.data.title}
  description={article.data.description}
  type="article"
  breadcrumbLabel={article.data.title}
  breadcrumbClass="max-w-3xl"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </Fragment>

  <article class="mx-auto max-w-3xl px-4 pb-16 pt-6 sm:px-6">
    <header>
      <h1 class="font-display text-4xl font-semibold leading-tight text-pine-800 sm:text-5xl">
        {article.data.title}
      </h1>
      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-pine-500">
        <time datetime={article.data.publishedAt.toISOString()}>
          {formatDate(article.data.publishedAt)}
        </time>
        {article.data.updatedAt && (
          <span>обновлено {formatDate(article.data.updatedAt)}</span>
        )}
        {article.data.tags.map((tag) => (
          <span class="rounded-full bg-pine-100 px-3 py-1 text-xs text-pine-700">{tag}</span>
        ))}
      </div>
    </header>

    <div class="article-content mt-10">
      <Content />
    </div>

    <aside class="mt-12 rounded-2xl border border-pine-100 bg-cream-50 p-6 sm:p-8">
      <p class="font-display text-2xl font-semibold text-pine-800">
        Хотите разобрать вашу ситуацию лично?
      </p>
      <p class="mt-2 leading-relaxed text-pine-700">
        Приглашаю на консультацию — очно в Ярославле или онлайн из любой точки мира.
        Вместе найдём, что поможет именно вам.
      </p>
      <a
        href={SocialLink.B17}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-block rounded-full bg-pine-500 px-6 py-2.5 font-medium text-cream-50 transition-colors hover:bg-pine-600"
      >
        Записаться на консультацию
      </a>
    </aside>

    <p class="mt-8 text-sm leading-relaxed text-pine-500">
      Статья носит информационный характер и не заменяет консультацию специалиста.
    </p>
  </article>
</Layout>
