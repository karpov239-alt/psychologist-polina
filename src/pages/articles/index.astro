---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '@layouts/Layout.astro';
import { formatDate } from '@utils/date';

const articles = (
  await getCollection('articles', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  )
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<Layout
  title="Статьи о психологии"
  description="Статьи психолога Полины Дворецкой: тревога, отношения, самоценность, детско-родительские отношения. Тёплые и практичные материалы от психолога из Ярославля."
>
  <section class="mx-auto max-w-4xl px-4 pb-16 pt-6 sm:px-6">
    <h1 class="font-display text-4xl font-semibold text-pine-800 sm:text-5xl">Статьи</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-pine-700">
      Здесь я делюсь мыслями о том, с чем люди чаще всего приходят на консультации:
      тревога, отношения, кризисы, поиск себя. Простыми словами и с практическими шагами.
    </p>

    {articles.length === 0 ? (
      <p class="mt-12 text-pine-700">Статьи скоро появятся.</p>
    ) : (
      <>
        <div
          id="articles-toolbar"
          hidden
          class="mt-8 rounded-2xl border border-pine-100 bg-cream-100 p-4 sm:p-5"
        >
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <label class="flex flex-col gap-1 text-sm text-pine-700 sm:col-span-2">
              Поиск по заголовку и ключевым словам
              <input
                id="articles-search"
                type="search"
                placeholder="Например: тревога"
                class="rounded-lg border border-pine-200 bg-cream-50 px-3 py-2 text-pine-800 placeholder:text-pine-400 focus:border-pine-400 focus:outline-none"
              />
            </label>
            <label class="flex flex-col gap-1 text-sm text-pine-700">
              С даты
              <input
                id="articles-date-from"
                type="date"
                class="rounded-lg border border-pine-200 bg-cream-50 px-3 py-2 text-pine-800 focus:border-pine-400 focus:outline-none"
              />
            </label>
            <label class="flex flex-col gap-1 text-sm text-pine-700">
              По дату
              <input
                id="articles-date-to"
                type="date"
                class="rounded-lg border border-pine-200 bg-cream-50 px-3 py-2 text-pine-800 focus:border-pine-400 focus:outline-none"
              />
            </label>
            <label class="flex flex-col gap-1 text-sm text-pine-700 sm:col-span-2">
              Сортировка
              <select
                id="articles-sort"
                class="rounded-lg border border-pine-200 bg-cream-50 px-3 py-2 text-pine-800 focus:border-pine-400 focus:outline-none"
              >
                <option value="date-desc">Сначала новые</option>
                <option value="date-asc">Сначала старые</option>
                <option value="title-asc">По названию А–Я</option>
                <option value="title-desc">По названию Я–А</option>
              </select>
            </label>
            <div class="flex items-end justify-between gap-3 sm:col-span-2">
              <p id="articles-count" class="text-sm text-pine-500" aria-live="polite"></p>
              <button
                type="button"
                data-reset-filters
                class="rounded-full border border-pine-300 px-4 py-2 text-sm text-pine-700 transition-colors hover:bg-pine-50"
              >
                Сбросить
              </button>
            </div>
          </div>
        </div>

        <div id="articles-empty" hidden class="mt-12 text-center text-pine-700">
          <p>По вашему запросу ничего не найдено.</p>
          <button
            type="button"
            data-reset-filters
            class="mt-4 rounded-full border border-pine-300 px-4 py-2 text-sm text-pine-700 transition-colors hover:bg-pine-50"
          >
            Сбросить фильтры
          </button>
        </div>

        <ul id="articles-list" class="mt-12 grid gap-6 sm:grid-cols-2">
          {articles.map((article) => (
            <li
              data-title={article.data.title.toLowerCase()}
              data-keywords={[...article.data.keywords, ...article.data.tags].join(' ').toLowerCase()}
              data-date={article.data.publishedAt.toISOString().slice(0, 10)}
            >
            <a
              href={`/articles/${article.id}/`}
              class="block overflow-hidden rounded-2xl border border-pine-100 bg-cream-50 transition-shadow hover:shadow-md"
            >
              {article.data.cover && (
                <Image
                  src={article.data.cover}
                  alt={article.data.coverAlt ?? ''}
                  widths={[400, 800]}
                  sizes="(min-width: 896px) 408px, 100vw"
                  class="aspect-[16/9] w-full object-cover"
                />
              )}
              <div class="p-5 sm:p-6">
                <h2 class="font-display text-xl font-semibold text-pine-800">
                  {article.data.title}
                </h2>
                <p class="mt-2 leading-relaxed text-pine-700">{article.data.description}</p>
                <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-pine-500">
                  <time datetime={article.data.publishedAt.toISOString()}>
                    {formatDate(article.data.publishedAt)}
                  </time>
                  {article.data.tags.map((tag) => (
                    <span class="rounded-full bg-pine-100 px-3 py-1 text-xs text-pine-700">{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          </li>
          ))}
        </ul>
      </>
    )}
  </section>

  <script>
    import { initArticlesFilter } from '@scripts/articles-filter';

    const list = document.getElementById('articles-list');
    const panel = document.getElementById('articles-toolbar');
    initArticlesFilter(
      list instanceof HTMLUListElement ? list : null,
      panel instanceof HTMLElement ? panel : null,
    );
  </script>
</Layout>
