---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
  toggle?: boolean;
  pressed?: boolean;
}

const { toggle = false, pressed = false, type = 'button', class: className, ...rest } = Astro.props;
---

<button
  type={type}
  class:list={[
    'inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm transition-colors',
    toggle
      ? 'border-pine-300 text-pine-700 hover:bg-pine-50 aria-[pressed=true]:border-pine-400 aria-[pressed=true]:bg-pine-100 aria-[pressed=true]:font-medium aria-[pressed=true]:text-pine-800'
      : 'border-pine-300 text-pine-700 hover:bg-pine-50',
    className,
  ]}
  aria-pressed={toggle ? pressed : undefined}
  {...rest}
>
  <slot />
</button>
