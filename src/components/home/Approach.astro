---
const methods = [
  {
    name: 'Понимающая психотерапия',
    text: 'Помогает разобраться в том, что происходит внутри: понять свои чувства, переживания и внутренние противоречия. Через внимательное отношение к собственному опыту постепенно появляется возможность по-новому увидеть ситуацию и найти свой способ справляться с трудностями.',
  },
  {
    name: 'Терапия принятия и ответственности (АСТ)',
    text: 'Учимся принимать то, что изменить нельзя, и направлять энергию на то, что действительно важно — на жизнь в согласии со своими ценностями.',
  },
  {
    name: 'Экзистенциальная психотерапия',
    text: 'Исследуем вопросы, которые возникают на важных поворотах жизни: чего я хочу, что для меня действительно важно, как сделать свой выбор и взять за него ответственность. Вместе ищем то, что помогает жить более осмысленно и в согласии с собой.',
  },
  {
    name: 'Метафорические ассоциативные карты (МАК)',
    text: 'Мягкий способ обратиться к чувствам и образам, которые бывает сложно выразить словами. Карты помогают посмотреть на ситуацию со стороны, лучше понять себя и заметить то, что раньше оставалось в тени.',
  },
] as const;

const steps = [
  {
    title: 'Заявка',
    text: 'Вы пишете мне, мы коротко обсуждаем запрос и выбираем удобное время.',
  },
  {
    title: 'Первая встреча',
    text: 'Знакомимся, вы рассказываете о ситуации в комфортном темпе. Мы определяем цель нашей работы.',
  },
  {
    title: 'Регулярные консультации',
    text: 'Встречаемся раз в неделю или в удобном вам ритме. Длительность работы зависит от запроса — обсудим на первой встрече.',
  },
  {
    title: 'Завершение',
    text: 'Подводим итоги и отмечаем то, что стало понятнее или изменилось в вашем взгляде на ситуацию: важные мысли, чувства и открытия, которые хочется сохранить и обдумать дальше.',
  },
] as const;
---

<section id="approach" class="bg-pine-900 text-cream-100">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-24">
    <h2 class="font-display text-3xl font-semibold text-cream-50 sm:text-4xl">Как я работаю</h2>
    <p class="mt-4 max-w-2xl leading-relaxed text-cream-200">
      В основе — экзистенциально-гуманистический подход. Мне важно создать пространство,
      в котором можно быть собой — говорить о том, что действительно волнует, не боясь
      оценки и необходимости сразу найти решение. Вместе мы будем исследовать, что
      происходит с вами, замечать свои чувства, потребности и привычные способы
      справляться с трудностями.
    </p>
    <p class="mt-4 max-w-2xl leading-relaxed text-cream-200">
      Я не даю готовых советов и не оцениваю то, что с вами происходит. Мне важно
      помочь вам лучше понять себя и постепенно найти то, что подходит именно вам.
    </p>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {methods.map((method) => (
        <li class="rounded-3xl bg-pine-800 p-6">
          <h3 class="text-lg font-semibold text-cream-50">{method.name}</h3>
          <p class="mt-2 text-sm leading-relaxed text-cream-200">{method.text}</p>
        </li>
      ))}
    </ul>

    <h3 class="mt-14 font-display text-2xl font-semibold text-cream-50">Как проходит работа</h3>
    <ol class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, index) => (
        <li class="relative rounded-3xl border border-pine-700 p-6">
          <p class="font-display text-3xl font-semibold text-clay-400">{index + 1}</p>
          <h4 class="mt-2 font-semibold text-cream-50">{step.title}</h4>
          <p class="mt-2 text-sm leading-relaxed text-cream-200">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
