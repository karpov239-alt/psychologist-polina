---
import '../styles/global.css';
import SEO from '@components/SEO.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { buildBreadcrumbs } from '@utils/breadcrumbs';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  type?: 'website' | 'article';
  breadcrumbLabel?: string;
}

const {
  title,
  description,
  canonical,
  type,
  breadcrumbLabel,
} = Astro.props;

const breadcrumbs = buildBreadcrumbs(Astro.url.pathname, breadcrumbLabel);
---

<!doctype html>
<html lang="ru">
  <head>
    <SEO title={title} description={description} canonical={canonical} type={type}>
      <slot name="head" />
    </SEO>
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-4 focus:rounded-lg focus:bg-pine-500 focus:px-4 focus:py-2 focus:text-cream-50"
    >
      Перейти к содержимому
    </a>
    <Header />
    <main id="main" class="flex-1">
      {breadcrumbs.length > 0 && (
        <div class="sticky top-14 z-30 w-full bg-cream-100/90 backdrop-blur">
          <div class="mx-auto w-full max-w-6xl px-4 py-3 sm:px-6">
            <Breadcrumbs items={breadcrumbs} />
          </div>
        </div>
      )}
      <slot />
    </main>
    <Footer />
  </body>
</html>
